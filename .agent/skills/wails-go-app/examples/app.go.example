package main

import (
	"fmt"

	"github.com/wailsapp/wails/v3/pkg/application"
)

// App struct implements the Wails v3 service
type App struct {
	app *application.App
}

// NewApp creates a new App service
func NewApp() *App {
	return &App{}
}

func (a *App) setApp(app *application.App) {
	a.app = app
}

func (a *App) getApp() *application.App {
	if a.app != nil {
		return a.app
	}
	return application.Get()
}

// ServiceStartup is called by Wails v3 when the service is initialized
func (a *App) ServiceStartup(ctx application.ServiceContext) error {
	return nil
}

// ============ File Dialogs ============

// SelectFile opens a file dialog and returns the selected file path
func (a *App) SelectFile(title string, extension string) (string, error) {
	app := a.getApp()
	dialog := app.Dialog.OpenFile()
	if title != "" {
		dialog.SetTitle(title)
	} else {
		dialog.SetTitle("Select File")
	}

	if extension != "" {
		dialog.AddFilter(fmt.Sprintf("Files (*%s)", extension), fmt.Sprintf("*%s", extension))
	} else {
		dialog.AddFilter("All Files (*.*)", "*.*")
	}

	return dialog.PromptForSingleSelection()
}

// SelectFolder opens a folder dialog and returns the selected directory path
func (a *App) SelectFolder(title string) (string, error) {
	app := a.getApp()
	dialog := app.Dialog.OpenFile()
	if title != "" {
		dialog.SetTitle(title)
	} else {
		dialog.SetTitle("Select Folder")
	}
	dialog.CanChooseDirectories(true)
	dialog.CanChooseFiles(false)
	return dialog.PromptForSingleSelection()
}

// ============ Events & Notifications ============

// EmitProgress emits progress updates to the frontend (0.0 to 1.0)
func (a *App) EmitProgress(progress float64) {
	a.getApp().Event.Emit("progress", progress)
}

// ShowInfo shows an information modal dialog
func (a *App) ShowInfo(title, message string) {
	dialog := a.getApp().Dialog.Info()
	dialog.SetTitle(title)
	dialog.SetMessage(message)
	dialog.Show()
}
