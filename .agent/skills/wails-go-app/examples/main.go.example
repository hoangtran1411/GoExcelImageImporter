package main

import (
	"embed"
	"log"

	"github.com/wailsapp/wails/v3/pkg/application"
)

//go:embed all:frontend/dist
var assets embed.FS

func main() {
	// 1. Create service instance
	appService := NewApp()

	// 2. Initialize Wails v3 application
	app := application.New(application.Options{
		Name:        "MyWailsApp",
		Description: "A modern desktop application built with Wails v3 and Go",
		Services: []application.Service{
			application.NewService(appService),
		},
		Assets: application.AssetFileServerFS(assets),
		SingleInstance: &application.SingleInstanceOptions{
			UniqueID: "com.example.mywailsapp",
			OnSecondInstanceLaunch: func(data application.SecondInstanceData) {
				if win, ok := application.Get().Window.GetByName("main"); ok {
					win.Restore()
					win.Focus()
				}
			},
		},
	})

	appService.setApp(app)

	// 3. Configure the primary window
	app.Window.NewWithOptions(application.WebviewWindowOptions{
		Name:             "main",
		Title:            "My Wails App",
		Width:            900,
		Height:           720,
		MinWidth:         700,
		MinHeight:        600,
		BackgroundColour: application.NewRGB(27, 38, 54),
	})

	// 4. Run application
	if err := app.Run(); err != nil {
		log.Fatal(err)
	}
}
