/**
 * Wails v3 Frontend JavaScript Template (ES Module)
 * Common patterns for Wails v3 apps
 */

import * as App from './bindings/main/app.js';
import { Events } from '/wails/runtime.js';

// ============ Event Listeners ============

// Listen for progress updates emitted by backend
Events.On('progress', function(event) {
    // Note: Wails v3 places the payload in event.data
    const progress = event.data;
    updateProgress(progress);
});

// Listen for status updates
Events.On('status', function(event) {
    const data = event.data;
    showStatus(data.message, data.type);
});

// ============ Go Method Calls ============

/**
 * Select a file using native Wails v3 dialog
 */
async function selectFile() {
    try {
        const path = await App.SelectFile('Select File', '');
        if (path) {
            const input = document.getElementById('filePath');
            if (input) input.value = path;
        }
    } catch (err) {
        showStatus('Error selecting file: ' + err, 'error');
    }
}

/**
 * Select a folder using native Wails v3 dialog
 */
async function selectFolder() {
    try {
        const path = await App.SelectFolder('Select Folder');
        if (path) {
            const input = document.getElementById('folderPath');
            if (input) input.value = path;
        }
    } catch (err) {
        showStatus('Error selecting folder: ' + err, 'error');
    }
}

/**
 * Start processing with progress tracking
 */
async function startProcess() {
    const btn = document.getElementById('processBtn');
    
    try {
        if (btn) btn.disabled = true;
        updateProgress(0);
        showStatus('Processing started...', 'info');

        // Call your Go service method here:
        // const result = await App.Process(config);

        showStatus('Processing completed successfully!', 'success');
    } catch (err) {
        showStatus('Error: ' + err, 'error');
    } finally {
        if (btn) btn.disabled = false;
    }
}

// ============ UI Helpers ============

function updateProgress(percent) {
    const fill = document.getElementById('progressFill');
    const text = document.getElementById('progressText');
    const displayVal = Math.round(percent * 100);
    
    if (fill) fill.style.width = displayVal + '%';
    if (text) text.textContent = displayVal + '%';
}

function showStatus(message, type = 'info') {
    const section = document.getElementById('statusSection');
    if (!section) return;
    
    section.className = 'status ' + type;
    section.textContent = message;
}

// ============ Attach to Window for Inline HTML Handlers ============
window.selectFile = selectFile;
window.selectFolder = selectFolder;
window.startProcess = startProcess;
