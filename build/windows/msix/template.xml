        AllowTelemetry="false"
        ApplyACLsToPackageFiles="true"
        GenerateCommandLineFile="true"
        AllowPromptForPassword="false">
    </Settings>
    <Installer
        Path="tool_chen_anh"
        Arguments=""
        InstallLocation="C:\Program Files\Hoang Tran\Image to Excel Importer">
    </Installer>
    <PackageInformation
        PackageName="Image to Excel Importer"
